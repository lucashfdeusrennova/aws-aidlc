# Copie para .env local e preencha com os outputs do `cdk deploy` +
# do `agentcore configure`. NAO COMMITAR o .env real.

AWS_REGION=us-east-1

# Do `agentcore launch` (ARN do runtime deployado)
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/hr-agent-XXXXXXXX

# Dos outputs do cdk deploy (InferenceProfileArnClaudeHaiku, InferenceProfileArnNovaPro)
INFERENCE_PROFILE_ARN_CLAUDE_HAIKU=arn:aws:bedrock:us-east-1:000000000000:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0
INFERENCE_PROFILE_ARN_NOVA_PRO=arn:aws:bedrock:us-east-1:000000000000:inference-profile/us.amazon.nova-pro-v1:0

# Do CDK output KnowledgeBaseId apos criacao da KB via console
KNOWLEDGE_BASE_ID=CHANGEME10
